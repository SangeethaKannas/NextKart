generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        Int     @id @default(autoincrement())
  title     String
  category  Category
  price     Float
  discount  Int
  inStock   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Category {
  ELECTRONICS
  BOOKS
  CLOTHING
  TOYS
  SPORTS
}
